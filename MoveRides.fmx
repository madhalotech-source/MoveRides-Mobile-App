          object cbAgreeTerms: TCheckBox
            Position.X = 103.000000000000000000
            Position.Y = 408.000000000000000000
            Size.Width = 378.000000000000000000
            Size.Height = 19.000000000000000000
            Size.PlatformDefault = False
            TabOrder = 0
            Text = 'I have read and agree tp the terms and conditions'
            OnChange = cbAgreeTermsChange
          end
          object memoTerms: TMemo
            Touch.InteractiveGestures = [Pan, LongTap, DoubleTap]
            DataDetectorTypes = []
            Lines.Strings = (
              'TERMS & CONDITIONS FOR USERS AND DRIVERS'
              ''
              ''
              '1. Introduction'
              'Welcome to Move Rides.'
              ''
              
                'These Terms and Conditions govern your use of the Move Rides mob' +
                'ile'
              
                'application. By accessing or using the app, you agree to comply ' +
                'with these terms'
              
                'and all applicable laws in South Africa, including the Protectio' +
                'n of Personal'
              ' Information Act (POPIA).'
              ''
              
                'Move Rides is a technology platform that connects users with ind' +
                'ependent'
              'drivers for transportation services.'
              ''
              '2. Nature of Service'
              'Move Rides does not provide transportation services directly.'
              'All transport services are provided by independent drivers.'
              ''
              '3. Accounts'
              'All users (including drivers) agree to:'
              ''
              'Provide accurate information'
              'Keep login details secure'
              'Not create fraudulent or duplicate accounts'
              '4. Privacy and Data Protection'
              
                'Move Rides collects and processes personal data (including name,' +
                ' email,'
              
                'and location) in accordance with POPIA. Please refer to our Priv' +
                'acy Policy for'
              'full details.'
              ''
              ' SECTION A: USER TERMS'
              '5. Ride Requests'
              'Users may request rides through the app'
              'A ride is only confirmed once accepted by a driver'
              '6. Pricing and Payment'
              'Users agree to pay the full fare displayed in the app'
              'Prices are fixed or predetermined unless otherwise stated'
              'Failure to pay may result in account suspension'
              '7. User Conduct'
              'Users must:'
              ''
              'Treat drivers respectfully'
              'Avoid abusive or inappropriate behavior'
              'Not damage vehicles'
              '8. Cancellations and Misuse'
              'Fake bookings or repeated cancellations may result in suspension'
              ' SECTION B: DRIVER TERMS'
              '9. Independent Contractor Status'
              
                'Drivers are independent contractors and not employees of Move Ri' +
                'des.'
              ''
              '10. Earnings and Commission'
              'Drivers receive 70% of each completed ride'
              'Move Rides retains 30% as a platform fee'
              '11. Ride Rules'
              'Drivers agree to:'
              ''
              'Transport a maximum of three (3) passengers per ride'
              'Maintain professionalism and good conduct'
              'Avoid any inappropriate or unlawful behavior'
              '12. Payments'
              'Drivers must follow the payment method in the app'
              
                'Unauthorized cash collection is prohibited and may result in pen' +
                'alties'
              '13. Vehicle Responsibility'
              'Drivers are responsible for:'
              ''
              'Vehicle maintenance'
              'Roadworthiness'
              'Legal compliance'
              'Move Rides is not liable for vehicle-related issues.'
              ''
              '14. Account Security'
              'Drivers must not share accounts'
              'Use of another driver'#8217's account is prohibited'
              '15. Driver Profile'
              'Drivers agree that their:'
              ''
              'Name'
              'Vehicle details'
              'Profile image'
              'May be displayed to users for identification and safety.'
              ''
              ' GENERAL TERMS'
              '16. Suspension and Termination'
              'Move Rides may suspend or terminate any account for:'
              ''
              'Fraud'
              'Misconduct'
              'Violation of these terms'
              '17. Limitation of Liability'
              'Move Rides is not responsible for:'
              ''
              'Incidents during rides'
              'Disputes between users and drivers'
              'Loss or damage of property'
              '18. Changes to Terms'
              
                'These Terms may be updated at any time. Continued use of the app' +
                ' means you accept the updated terms.'
              ''
              '19. Governing Law'
              
                'These Terms are governed by the laws of the Republic of South Af' +
                'rica.')
            ReadOnly = True
            Position.X = 57.000000000000000000
            Size.Width = 400.000000000000000000
            Size.Height = 400.000000000000000000
            Size.PlatformDefault = False
            TabOrder = 1
            Viewport.Width = 380.000000000000000000
            Viewport.Height = 380.000000000000000000
          end
